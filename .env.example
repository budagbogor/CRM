NODE_ENV="development"
APP_ENV="demo"
APP_NAME="Mobeng CRM"
AUTH_SECRET="change-this-to-a-long-random-secret"
DATABASE_URL="postgresql://autoretention:autoretention@localhost:5432/autoretention_crm?schema=public"

# Notification providers (mock by default)
NOTIFICATION_PROVIDER_WHATSAPP="mock"
NOTIFICATION_PROVIDER_EMAIL="mock"
NOTIFICATION_PROVIDER_SMS="mock"
DEFAULT_NOTIFICATION_FROM_EMAIL="halo@mobeng.co.id"
DEFAULT_NOTIFICATION_FROM_NAME="Mobeng CRM"

# Job runner foundation
JOB_RUNNER_MODE="database"
JOB_RUNNER_POLL_INTERVAL_MS="60000"

# File storage foundation
FILE_STORAGE_PROVIDER="mock-local"
UPLOAD_MAX_MB="5"

# App security placeholders
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_WINDOW_MS="60000"
