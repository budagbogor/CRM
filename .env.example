NODE_ENV="development"
APP_ENV="demo"
APP_NAME="Mobeng CRM"
APP_VERSION="0.1.0"
LOG_LEVEL="info"
ERROR_TRACKING_PROVIDER="console"
SENTRY_DSN=""
AUTH_SECRET="change-this-to-a-long-random-secret"
INTEGRATION_API_KEY="change-this-to-a-long-random-integration-key"
DATABASE_URL="postgresql://autoretention:autoretention@localhost:5432/autoretention_crm?schema=public"
DIRECT_URL="postgresql://autoretention:autoretention@localhost:5432/autoretention_crm?schema=public"

# Notification providers
NOTIFICATION_PROVIDER="mock"
EMAIL_PROVIDER="mock"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="halo@mobeng.co.id"
DEFAULT_NOTIFICATION_FROM_EMAIL="halo@mobeng.co.id"
DEFAULT_NOTIFICATION_FROM_NAME="Mobeng CRM"

# Job runner foundation
JOB_RUNNER_MODE="database"
JOB_RUNNER_POLL_INTERVAL_MS="60000"

# File storage foundation
FILE_STORAGE_PROVIDER="mock-local"
UPLOAD_MAX_MB="5"

# App security placeholders
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_WINDOW_MS="60000"
CRON_SECRET="change-this-cron-secret"
ALLOW_DEMO_SEED="false"
